# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
/build/
.venv/

# Config (real config has secrets)
matrix.config.json
# The previous name of the same file. A local config is not renamed just because
# the project is, so ignoring only the new name un-ignored every existing
# install's config — and a `git add -A` then committed one, with its API key, to
# a public repository. Both names stay listed.
openmatrix.config.json
.env
.env.stripe
.env.rotated

# Memory data (agent conversation/kv storage at runtime)
/memory/

# Hivemind runtime state. hivemind/ itself is tracked SOURCE; the orchestrator
# (default workspace ".") writes its event log, sessions and queues into it.
# tests/test_runtime_artifacts_ignored.py derives these paths by running the
# writers, and fails if one lands somewhere git would commit.
/hivemind/events.jsonl
/hivemind/sessions/
/hivemind/queues/

# Private on the release axis too (scripts/prepare_release.py PRIVATE_FILES),
# none of them tracked. Anchored at the root, so same-named source directories
# elsewhere (runtime/blockchain/services/governance/, …) stay tracked.
/neowrite.env
/secrets/
/identity/
/governance/
/runtime/cache/
/runtime/streams/
/runtime/usage/
/runtime/memory_sync/
/gateway/gateway.pid
/gateway/gateway.log
/gateway/gateway.err.log
/gateway/status.json

# SQLite database, WAL/SHM files, and daily backups
/data/
*.db
*.db-wal
*.db-shm

# Generated API docs site
/site/

# Deploy and demo artifacts
demo_deployment.json
deployment_manifest.json
# What the scripts write into the tree (tests/test_script_outputs_are_ignored.py
# derives these from the scripts): scripts/deploy_all.py's cache of each
# compiled contract's ABI and bytecode, scripts/verify_platform.py's report on
# a deployment, and scripts/prepare_release.py's manifest, which names the
# private files it found, and its export, a copy of the public tree.
/artifacts/
/platform_health_report.json
/RELEASE_MANIFEST.md
/export/
# npm install next to a package.json (sdk-js/)
node_modules/

# Private internal documents
private/

# Imported data
imported/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Internal — launch materials, grant applications, ops scripts, business docs
launch/
grants/
dedication/
ROADMAP.md
scripts/generate_launch_pdf.py
scripts/rotate_credentials.sh
scripts/prepare_finetuning.py
scripts/stripe_setup.py
docs/RUNBOOK.md
docs/MONETIZATION.md
docs/REVENUE_STREAMS.md
docs/SPONSORSHIP.md
docs/OPEN_COLLECTIVE.md
docs/FINETUNING_GUIDE.md
web/revenue.html
web/pricing.html
AUDIT_BASELINE*.txt
contracts/out/
contracts/cache/
# What contracts/deploy.py writes on a run: each deployed contract's ABI and
# the deployment record (network, chain id, addresses). One operator's output.
contracts/deployment.json
contracts/*.abi.json
