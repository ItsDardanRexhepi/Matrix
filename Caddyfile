# The Matrix Caddy configuration.
#
# Caddy auto-provisions Let's Encrypt certificates for the site block
# below (HTTP-01 challenge on port 80). The upstream is the gateway
# container on the internal compose network.
#
# Override ``MATRIX_DOMAIN`` / ``MATRIX_ADMIN_EMAIL`` via environment
# variables when launching compose.

{
	email {$MATRIX_ADMIN_EMAIL}
	# Turn off Caddy's admin API (by default an HTTP endpoint on
	# localhost:2019 that reads and replaces the running config). With it
	# off, the running config cannot be read or changed over HTTP, and
	# `caddy reload`, which uses that API, does not work. Nor can a
	# healthcheck use it: docker-compose.prod.yml checks the loopback
	# listener below instead.
	admin off
	# Serve HTTP/1.1, HTTP/2 and HTTP/3 (Caddy's default, stated). HTTP/3
	# runs over QUIC, which is why compose publishes 443/udp. Compression
	# is the `encode` line in the site block, not this.
	servers {
		protocols h1 h2 h3
	}
}

# Liveness for the container healthcheck in docker-compose.prod.yml. Plain
# HTTP on port 2020, bound to the container's loopback only, and not
# published by compose, so nothing outside the container can reach it. It
# answers when Caddy's HTTP server is up; it does not proxy to the gateway,
# whose own healthcheck gates Caddy's start.
:2020 {
	bind 127.0.0.1
	respond "ok" 200
}

{$MATRIX_DOMAIN} {
	encode zstd gzip

	# /health straight to the gateway. Caddy applies no auth and no rate
	# limit to any path in this file; the gateway does both.
	handle /health {
		reverse_proxy gateway:18790
	}

	# WebSocket upgrades need an explicit handler so Caddy doesn't
	# buffer them. ``reverse_proxy`` detects Upgrade headers
	# automatically, but the matcher below documents the intent.
	@websockets {
		header Connection *Upgrade*
		header Upgrade    websocket
	}
	handle @websockets {
		reverse_proxy gateway:18790
	}

	# All other HTTP traffic flows to the gateway.
	handle {
		reverse_proxy gateway:18790 {
			# Pass the real client IP so per-IP rate limiting
			# buckets anonymous traffic correctly.
			header_up X-Forwarded-For  {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP        {remote_host}
			# 2 minute budget to match the gateway's default
			# request timeout middleware.
			transport http {
				dial_timeout  5s
				read_timeout  120s
				write_timeout 120s
			}
		}
	}

	# Security headers — sensible defaults for an API backend.
	header {
		# Force HTTPS for a year, include subdomains, preload opt-in.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Refuse to be rendered inside any frame.
		X-Frame-Options "DENY"
		# Block MIME sniffing.
		X-Content-Type-Options "nosniff"
		# Minimal Referrer-Policy for an API.
		Referrer-Policy "no-referrer"
		# Drop the `Server: Caddy` header Caddy adds by default.
		-Server
	}

	# Log every request in JSON — pipe to stdout so Docker collects it.
	log {
		output stdout
		format json
	}
}
